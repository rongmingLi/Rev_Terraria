		"CapsLock": "Verr. maj.",
		"ScrollLock": "Verr. défil.",
		"RightShift": "Maj. droite",
		"LeftShift": "Maj. gauche",
		"RightControl": "Ctrl droit",
		"LeftControl": "Ctrl gauche",
