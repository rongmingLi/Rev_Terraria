		"RightCommand": "Commande droite",
		"RightApple": "Commande droite",
		"LeftCommand": "Commande gauche",
		"LeftApple": "Commande gauche",
		"LeftWindows": "Windows gauche",
		"RightWindows": "Windows droit",
		"AltGr": "Alt Gr",
		"Help": "Aide",
		"Print": "Imprimer",
		"SysReq": "SysReq",
