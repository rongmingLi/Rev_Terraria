		"LeftControl": "Control izquierdo",
		"RightAlt": "Alt derecho",
		"LeftAlt": "Alt izquierdo",
		"RightCommand": "Comando derecho",
		"RightApple": "Comando derecho",
		"LeftCommand": "Comando izquierdo",
		"LeftApple": "Comando izquierdo",
		"LeftWindows": "Windows izquierdo",
		"RightWindows": "Windows derecho",
		"AltGr": "Alt Gr",
		"Help": "Ayuda",
		"Print": "Impr Pant",
		"SysReq": "Pet Sis",
		"Break": "Interrumpir",
		"Menu": "Menú",
		"Mouse0": "Clic izquierdo",
		"Mouse1": "Clic derecho",
		"Mouse2": "Clic central",
		"MouseCursor": "El ratón",
		"MouseWheel": "Rueda del ratón",
